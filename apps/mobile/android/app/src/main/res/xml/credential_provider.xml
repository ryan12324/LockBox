<?xml version="1.0" encoding="utf-8"?>
<!--
  Credential Provider capability declaration.
  Registers Authwell as a password and passkey provider on Android 14+.
-->
<credential-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="dev.lockbox.app.MainActivity"
    android:settingsSubtitle="@string/credential_provider_subtitle">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
