{
  "name": "@lockbox/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor Android and iOS app for the Authwell password manager",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "build:android": "tsc && bunx cap sync android",
    "build:ios": "tsc && bunx cap sync ios",
    "build:ios:release": "../../scripts/build-ios-release.sh",
    "test:ios-native": "../../scripts/test-ios-native.sh",
    "dev:android": "tsc --watch & bunx cap run android",
    "dev:ios": "tsc --watch & bunx cap run ios",
    "sync": "bunx cap sync",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/network": "^6.0.0",
    "@lockbox/importers": "*",
    "@lockbox/types": "*"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
